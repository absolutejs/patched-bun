index 00000000..115e54c7
--- /dev/null
+++ b/test/js/bun/jsc/lockdown-fixture.ts
@@ -0,0 +1,36 @@
+import { heapSize, lockdown } from "bun:jsc";
+import { readFileSync } from "node:fs";
+
+const send = postMessage;
+const probe = async (code: string) => {
+  try {
+    return String(await (0, eval)(code));
+  } catch (error) {
+    return `threw ${(error as Error).name}: ${(error as Error).message}`;
+  }
+};
+
+const before = {
+  bun: await probe("typeof Bun"),
+  importFs: await probe("import('node:fs').then(m => typeof m.readFileSync)"),
+};
+
+lockdown();
+lockdown();
+
+send({
+  before,
+  after: {
+    bun: await probe("typeof Bun"),
+    indirectEval: await probe("typeof (0, eval)('Bun')"),
+    functionConstructor: await probe("typeof new Function('return Bun')()"),
+    globalThisBun: await probe("typeof globalThis.Bun"),
+    shadowRealm: await probe("typeof ShadowRealm"),
+    importFs: await probe("import('node:fs').then(m => typeof m.readFileSync)"),
+    importChildProcess: await probe("import('node:child_process').then(m => typeof m.spawnSync)"),
+    importFfi: await probe("import('bun:ffi').then(m => typeof m.dlopen)"),
+    staticImportStillWorks: typeof readFileSync,
+    heapSizeStillWorks: typeof heapSize(),
+    webApisStillWork: await probe("typeof new Response('ok').text"),
+  },
+});
diff --git a/test/js/bun/jsc/lockdown.test.ts b/test/js/bun/jsc/lockdown.test.ts
new file mode 100644
index 00000000..66340e3d
--- /dev/null
+++ b/test/js/bun/jsc/lockdown.test.ts
@@ -0,0 +1,32 @@
+import { expect, test } from "bun:test";
+import { lockdown } from "bun:jsc";
+
+test("lockdown() throws outside a Worker", () => {
+  expect(() => lockdown()).toThrow("lockdown() can only be called inside a Worker");
+  expect(typeof Bun).toBe("object");
+});
+
+test("lockdown() removes Bun and ShadowRealm and disables import() in a Worker", async () => {
+  const worker = new Worker(new URL("./lockdown-fixture.ts", import.meta.url).href);
+  const { promise, resolve, reject } = Promise.withResolvers<any>();
+  worker.onmessage = event => resolve(event.data);
+  worker.onerror = event => reject(event);
+  const result = await promise;
+  worker.terminate();
+
+  expect(result.before).toEqual({ bun: "object", importFs: "function" });
+  const rejected = "threw TypeError: import() is disabled in this realm by lockdown()";
+  expect(result.after).toEqual({
+    bun: "undefined",
+    indirectEval: "threw ReferenceError: Bun is not defined",
+    functionConstructor: "threw ReferenceError: Bun is not defined",
+    globalThisBun: "undefined",
+    shadowRealm: "undefined",
+    importFs: rejected,
+    importChildProcess: rejected,
+    importFfi: rejected,
+    staticImportStillWorks: "function",
+    heapSizeStillWorks: "number",
+    webApisStillWork: "function",
+  });
+});
