+// lockdown(): for a Worker that is about to run code it does not trust. Removes
+// the `Bun` global (which is non-configurable, so JavaScript cannot delete it and
+// indirect eval or the Function constructor would still reach it) and makes every
+// later import() in the Worker reject. It also removes `ShadowRealm`, whose fresh
+// realm would carry a new `Bun`. Modules the Worker imported statically
+// before calling it stay usable; `require` is an ordinary configurable global the
+// caller deletes itself. One-way and idempotent. Only allowed inside a Worker,
+// where it cannot break the process.
+JSC_DEFINE_HOST_FUNCTION(functionLockdown, (JSGlobalObject * globalObject, CallFrame*))
+{
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    auto* zigGlobalObject = defaultGlobalObject(globalObject);
+    if (!WebCore::clientData(vm)->isWorkerVM()) {
+        throwTypeError(globalObject, scope, "lockdown() can only be called inside a Worker"_s);
+        return {};
+    }
+
+    zigGlobalObject->m_moduleLoadingLockedDown = true;
+
+    {
+        VM::DeletePropertyModeScope deleteScope(vm, VM::DeletePropertyMode::IgnoreConfigurable);
+        DeletePropertySlot bunSlot;
+        zigGlobalObject->methodTable()->deleteProperty(zigGlobalObject, zigGlobalObject, Identifier::fromString(vm, "Bun"_s), bunSlot);
+        RETURN_IF_EXCEPTION(scope, {});
+        // A ShadowRealm gets a fresh global with its own `Bun`, and returns
+        // callables from it, so it would hand the authority straight back.
+        DeletePropertySlot shadowRealmSlot;
+        zigGlobalObject->methodTable()->deleteProperty(zigGlobalObject, zigGlobalObject, Identifier::fromString(vm, "ShadowRealm"_s), shadowRealmSlot);
+        RETURN_IF_EXCEPTION(scope, {});
+    }
+
+    return JSValue::encode(jsUndefined());
+}
